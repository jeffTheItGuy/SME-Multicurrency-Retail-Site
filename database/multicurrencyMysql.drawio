<mxfile host="Electron">
  <diagram name="Page-1" id="W1jkCmUQVi9k6DQhoasa">
    <mxGraphModel dx="2552" dy="1648" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam class {\n    BorderThickness 1.5\n    ArrowColor #424242\n    FontColor #212121\n}\n\n&#39; ===== CURRENCY &amp; PRICING (Cyan) =====\nentity currencies #E0F7FA {\n    * currency_code : CHAR(3) &lt;&lt;PK&gt;&gt;\n    --\n    * currency_name : VARCHAR(100)\n    * symbol : VARCHAR(10)\n    * decimal_places : INT &lt;&lt;DF 2&gt;&gt;\n    * is_base_currency : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * is_active : BOOLEAN &lt;&lt;DF TRUE&gt;&gt;\n    * created_at : TIMESTAMP\n}\n\nentity exchange_rates #E0F7FA {\n    * rate_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * from_currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * to_currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * rate : DECIMAL(24,10)\n    * inverse_rate : DECIMAL(24,10)\n    * rate_type : ENUM(&#39;OFFICIAL&#39;,&#39;PARALLEL&#39;,&#39;BLENDED&#39;,&#39;CUSTOM&#39;)\n    * effective_date : DATE\n    * created_by : UUID\n    * created_at : TIMESTAMP\n    --\n    &lt;&lt;UQ&gt;&gt; (from_currency, to_currency, rate_type, effective_date)\n}\n\nentity product_prices #E0F7FA {\n    * price_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * price_type : ENUM(&#39;RETAIL&#39;,&#39;WHOLESALE&#39;,&#39;BULK&#39;,&#39;SPECIAL&#39;)\n    * price : DECIMAL(24,6)\n    * min_quantity : INT &lt;&lt;DF 1&gt;&gt;\n    * effective_from : DATE\n    * effective_to : DATE\n    * is_active : BOOLEAN &lt;&lt;DF TRUE&gt;&gt;\n    * created_at : TIMESTAMP\n    --\n    &lt;&lt;UQ&gt;&gt; (product_id, currency_code, price_type, effective_from)\n}\n\nentity price_history #E0F7FA {\n    * history_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * price_type : ENUM(&#39;RETAIL&#39;,&#39;WHOLESALE&#39;,&#39;BULK&#39;,&#39;SPECIAL&#39;)\n    * old_price : DECIMAL(24,6)\n    * new_price : DECIMAL(24,6)\n    * changed_by : UUID\n    * changed_at : TIMESTAMP\n}\n\n&#39; ===== PRODUCT CATALOG (Blue) =====\nentity product_categories #E3F2FD {\n    * category_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * category_name : VARCHAR(100)\n    * parent_category_id : UUID &lt;&lt;FK&gt;&gt;\n    * description : TEXT\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\nentity units_of_measure #E3F2FD {\n    * uom_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * uom_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * uom_name : VARCHAR(100)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\nentity products #E3F2FD {\n    * product_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * sku : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * barcode : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * product_name : VARCHAR(255)\n    * description : TEXT\n    * category_id : UUID &lt;&lt;FK&gt;&gt;\n    * uom_id : UUID &lt;&lt;FK&gt;&gt;\n    * vat_category_id : UUID &lt;&lt;FK&gt;&gt;\n    * track_inventory : BOOLEAN &lt;&lt;DF TRUE&gt;&gt;\n    * is_active : BOOLEAN\n    * deleted_at : TIMESTAMP\n    * created_at : TIMESTAMP\n    * updated_at : TIMESTAMP\n}\n\nentity supplier_products #E3F2FD {\n    * supplier_product_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * supplier_id : UUID &lt;&lt;FK&gt;&gt;\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * supplier_sku : VARCHAR(50)\n    * supplier_product_name : VARCHAR(255)\n    * is_preferred : BOOLEAN\n    * lead_time_days : INT\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== INVENTORY &amp; FIFO VALUATION (Green) =====\nentity warehouses #E8F5E9 {\n    * warehouse_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * warehouse_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * warehouse_name : VARCHAR(100)\n    * location : VARCHAR(255)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\nentity inventory #E8F5E9 {\n    * inventory_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity_on_hand : DECIMAL(18,3) &lt;&lt;DF 0&gt;&gt;\n    * quantity_reserved : DECIMAL(18,3) &lt;&lt;DF 0&gt;&gt;\n    * quantity_available : DECIMAL(18,3) &lt;&lt;DF 0&gt;&gt;\n    * reorder_level : DECIMAL(18,3) &lt;&lt;DF 0&gt;&gt;\n    * reorder_quantity : DECIMAL(18,3)\n    * last_counted_at : TIMESTAMP\n    * updated_at : TIMESTAMP\n    --\n    &lt;&lt;UQ&gt;&gt; (product_id, warehouse_id)\n}\n\nentity inventory_layers #E8F5E9 {\n    * layer_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * grn_item_id : UUID &lt;&lt;FK&gt;&gt;\n    * batch_number : VARCHAR(50)\n    * expiry_date : DATE\n    * original_quantity : DECIMAL(18,3)\n    * remaining_quantity : DECIMAL(18,3)\n    * unit_cost : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * total_cost : DECIMAL(24,6)\n    * received_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\nentity inventory_transactions #E8F5E9 {\n    * transaction_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * transaction_type : ENUM(&#39;PURCHASE&#39;,&#39;SALE&#39;,&#39;ADJUSTMENT&#39;,&#39;RETURN_IN&#39;,&#39;RETURN_OUT&#39;,&#39;TRANSFER_IN&#39;,&#39;TRANSFER_OUT&#39;)\n    * reference_type : ENUM(&#39;SALE&#39;,&#39;PO&#39;,&#39;GRN&#39;,&#39;ADJUSTMENT&#39;,&#39;TRANSFER&#39;)\n    * reference_id : UUID\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity : DECIMAL(18,3)\n    * unit_cost : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * transaction_date : TIMESTAMP\n    * notes : TEXT\n    * created_at : TIMESTAMP\n}\n\nentity inventory_consumptions #E8F5E9 {\n    * consumption_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n    * layer_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity_consumed : DECIMAL(18,3)\n    * unit_cost : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * cogs_amount : DECIMAL(24,6)\n    * created_at : TIMESTAMP\n}\n\nentity cogs_entries #E8F5E9 {\n    * cogs_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * sale_item_id : UUID &lt;&lt;FK&gt;&gt;\n    * inventory_consumption_id : UUID &lt;&lt;FK&gt;&gt;\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity : DECIMAL(18,3)\n    * unit_cost : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * total_cogs : DECIMAL(24,6)\n    * base_currency_cogs : DECIMAL(24,6)\n    * cogs_date : DATE\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== PROCUREMENT (Amber) =====\nentity suppliers #FFF8E1 {\n    * supplier_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * supplier_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * supplier_name : VARCHAR(200)\n    * contact_person : VARCHAR(100)\n    * phone : VARCHAR(20)\n    * email : VARCHAR(255)\n    * tax_number : VARCHAR(50)\n    * address : TEXT\n    * payment_terms_days : INT\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\nentity purchase_orders #FFF8E1 {\n    * po_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * po_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * supplier_id : UUID &lt;&lt;FK&gt;&gt;\n    * warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * order_date : TIMESTAMP\n    * expected_delivery_date : DATE\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * exchange_rate : DECIMAL(24,10)\n    * subtotal : DECIMAL(24,6)\n    * vat_total : DECIMAL(24,6)\n    * total : DECIMAL(24,6)\n    * status : ENUM(&#39;DRAFT&#39;,&#39;SENT&#39;,&#39;PARTIAL&#39;,&#39;RECEIVED&#39;,&#39;CANCELLED&#39;)\n    * notes : TEXT\n    * created_by : UUID\n    * created_at : TIMESTAMP\n}\n\nentity po_items #FFF8E1 {\n    * po_item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * po_id : UUID &lt;&lt;FK&gt;&gt;\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity_ordered : DECIMAL(18,3)\n    * quantity_received : DECIMAL(18,3) &lt;&lt;DF 0&gt;&gt;\n    * unit_price : DECIMAL(24,6)\n    * vat_rate : DECIMAL(5,2)\n    * line_total : DECIMAL(24,6)\n    * created_at : TIMESTAMP\n}\n\nentity goods_receipts #FFF8E1 {\n    * grn_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * grn_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * po_id : UUID &lt;&lt;FK&gt;&gt;\n    * supplier_id : UUID &lt;&lt;FK&gt;&gt;\n    * warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * receipt_date : TIMESTAMP\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * exchange_rate : DECIMAL(24,10)\n    * status : ENUM(&#39;PENDING&#39;,&#39;POSTED&#39;,&#39;CANCELLED&#39;)\n    * notes : TEXT\n    * created_by : UUID\n    * created_at : TIMESTAMP\n}\n\nentity grn_items #FFF8E1 {\n    * grn_item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * grn_id : UUID &lt;&lt;FK&gt;&gt;\n    * po_item_id : UUID &lt;&lt;FK&gt;&gt;\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity_received : DECIMAL(18,3)\n    * unit_cost : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * line_total : DECIMAL(24,6)\n    * batch_number : VARCHAR(50)\n    * expiry_date : DATE\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== CUSTOMERS &amp; SALES (Red) =====\nentity customers #FFEBEE {\n    * customer_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * customer_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * customer_name : VARCHAR(200)\n    * phone : VARCHAR(20)\n    * email : VARCHAR(255)\n    * tax_number : VARCHAR(50)\n    * address : TEXT\n    * credit_limit : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\nentity sales #FFEBEE {\n    * sale_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * sale_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * customer_id : UUID &lt;&lt;FK&gt;&gt;\n    * warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * cashier_id : UUID\n    * sale_date : TIMESTAMP\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * exchange_rate : DECIMAL(24,10)\n    * subtotal : DECIMAL(24,6)\n    * discount_total : DECIMAL(24,6)\n    * vat_total : DECIMAL(24,6)\n    * total : DECIMAL(24,6)\n    * base_currency_total : DECIMAL(24,6)\n    * payment_status : ENUM(&#39;PENDING&#39;,&#39;PARTIAL&#39;,&#39;PAID&#39;,&#39;CANCELLED&#39;)\n    * notes : TEXT\n    * created_at : TIMESTAMP\n}\n\nentity sale_items #FFEBEE {\n    * sale_item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * sale_id : UUID &lt;&lt;FK&gt;&gt;\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity : DECIMAL(18,3)\n    * unit_price : DECIMAL(24,6)\n    * unit_cost : DECIMAL(24,6)\n    * discount_amount : DECIMAL(24,6)\n    * vat_rate : DECIMAL(5,2)\n    * vat_amount : DECIMAL(24,6)\n    * line_total : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * created_at : TIMESTAMP\n}\n\nentity payments #FFEBEE {\n    * payment_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * sale_id : UUID &lt;&lt;FK&gt;&gt;\n    * payment_method : ENUM(&#39;CASH&#39;,&#39;ECOCASH&#39;,&#39;ZIPIT&#39;,&#39;BANK_TRANSFER&#39;,&#39;CARD&#39;,&#39;USD_CASH&#39;,&#39;ZiG_CASH&#39;)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * amount : DECIMAL(24,6)\n    * exchange_rate : DECIMAL(24,10)\n    * base_currency_amount : DECIMAL(24,6)\n    * reference_number : VARCHAR(100)\n    * received_by : UUID\n    * payment_date : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== ZIMRA TAX &amp; INVOICING (Purple) =====\nentity vat_categories #F3E5F5 {\n    * vat_category_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * category_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * category_name : VARCHAR(100)\n    * vat_rate : DECIMAL(5,2)\n    * description : TEXT\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\nentity invoices #F3E5F5 {\n    * invoice_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * sale_id : UUID &lt;&lt;FK&gt;&gt;\n    * invoice_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * zimra_invoice_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * fiscal_device_id : VARCHAR(50)\n    * fiscal_signature : VARCHAR(500)\n    * customer_id : UUID &lt;&lt;FK&gt;&gt;\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * exchange_rate : DECIMAL(24,10)\n    * subtotal : DECIMAL(24,6)\n    * vat_total : DECIMAL(24,6)\n    * total : DECIMAL(24,6)\n    * base_currency_total : DECIMAL(24,6)\n    * invoice_date : TIMESTAMP\n    * fiscalisation_date : TIMESTAMP\n    * status : ENUM(&#39;DRAFT&#39;,&#39;FISCALISED&#39;,&#39;CANCELLED&#39;,&#39;CREDIT_NOTE&#39;)\n    * zimra_submitted_at : TIMESTAMP\n    * created_at : TIMESTAMP\n}\n\nentity invoice_items #F3E5F5 {\n    * invoice_item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * invoice_id : UUID &lt;&lt;FK&gt;&gt;\n    * sale_item_id : UUID &lt;&lt;FK&gt;&gt;\n    * product_id : UUID &lt;&lt;FK&gt;&gt;\n    * description : TEXT\n    * quantity : DECIMAL(18,3)\n    * unit_price : DECIMAL(24,6)\n    * vat_rate : DECIMAL(5,2)\n    * vat_amount : DECIMAL(24,6)\n    * line_total : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * created_at : TIMESTAMP\n}\n\nentity vat_records #F3E5F5 {\n    * vat_record_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * invoice_id : UUID &lt;&lt;FK&gt;&gt;\n    * vat_category_id : UUID &lt;&lt;FK&gt;&gt;\n    * taxable_amount : DECIMAL(24,6)\n    * vat_rate : DECIMAL(5,2)\n    * vat_amount : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * base_currency_amount : DECIMAL(24,6)\n    * tax_period : VARCHAR(7)\n    * submitted_to_zimra_at : TIMESTAMP\n    * zimra_ack_code : VARCHAR(100)\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== STOCK CONTROL (Deep Orange) =====\nentity stock_adjustment_reasons #FFE0B2 {\n    * reason_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * reason_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * reason_name : VARCHAR(100)\n    * description : TEXT\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMP\n}\n\nentity stock_adjustments #FFE0B2 {\n    * adjustment_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * adjustment_date : TIMESTAMP\n    * reason_id : UUID &lt;&lt;FK&gt;&gt;\n    * notes : TEXT\n    * total_value_impact : DECIMAL(24,6)\n    * currency_code : CHAR(3) &lt;&lt;FK&gt;&gt;\n    * created_by : UUID\n    * created_at : TIMESTAMP\n}\n\nentity stock_transfers #FFE0B2 {\n    * transfer_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * from_warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * to_warehouse_id : UUID &lt;&lt;FK&gt;&gt;\n    * transfer_date : TIMESTAMP\n    * status : ENUM(&#39;PENDING&#39;,&#39;IN_TRANSIT&#39;,&#39;COMPLETED&#39;,&#39;CANCELLED&#39;)\n    * notes : TEXT\n    * created_by : UUID\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== AUDIT &amp; SYSTEM (Gray) =====\nentity audit_logs #F5F5F5 {\n    * log_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID\n    * action : VARCHAR(100)\n    * entity_type : VARCHAR(50)\n    * entity_id : UUID\n    * old_values : JSON\n    * new_values : JSON\n    * ip_address : VARCHAR(45)\n    * created_at : TIMESTAMP\n}\n\n&#39; ===== RELATIONSHIPS =====\ncurrencies ||--o{ exchange_rates : from\ncurrencies ||--o{ exchange_rates : to\ncurrencies ||--o{ product_prices\ncurrencies ||--o{ inventory_layers\ncurrencies ||--o{ inventory_transactions\ncurrencies ||--o{ inventory_consumptions\ncurrencies ||--o{ cogs_entries\ncurrencies ||--o{ suppliers\ncurrencies ||--o{ purchase_orders\ncurrencies ||--o{ grn_items\ncurrencies ||--o{ customers\ncurrencies ||--o{ sales\ncurrencies ||--o{ sale_items\ncurrencies ||--o{ payments\ncurrencies ||--o{ invoices\ncurrencies ||--o{ invoice_items\ncurrencies ||--o{ vat_records\ncurrencies ||--o{ stock_adjustments\n\nvat_categories ||--o{ products\nvat_categories ||--o{ vat_records\n\nproduct_categories ||--o{ product_categories : parent\nproduct_categories ||--o{ products\n\nunits_of_measure ||--o{ products\n\nproducts ||--o{ product_prices\nproducts ||--o{ price_history\nproducts ||--o{ supplier_products\nproducts ||--o{ inventory\nproducts ||--o{ inventory_layers\nproducts ||--o{ inventory_transactions\nproducts ||--o{ inventory_consumptions\nproducts ||--o{ cogs_entries\nproducts ||--o{ po_items\nproducts ||--o{ grn_items\nproducts ||--o{ sale_items\nproducts ||--o{ invoice_items\n\nsuppliers ||--o{ supplier_products\nsuppliers ||--o{ purchase_orders\nsuppliers ||--o{ goods_receipts\n\nwarehouses ||--o{ inventory\nwarehouses ||--o{ inventory_layers\nwarehouses ||--o{ inventory_transactions\nwarehouses ||--o{ purchase_orders\nwarehouses ||--o{ goods_receipts\nwarehouses ||--o{ sales\nwarehouses ||--o{ stock_adjustments\nwarehouses ||--o{ stock_transfers : from\nwarehouses ||--o{ stock_transfers : to\n\ninventory_layers ||--o{ inventory_consumptions\ninventory_layers ||--o| grn_items : sourced_from\n\ninventory_transactions ||--o{ inventory_consumptions\n\npurchase_orders ||--o{ po_items\npurchase_orders ||--o{ goods_receipts\n\npo_items ||--o{ grn_items\n\ngoods_receipts ||--o{ grn_items\n\ncustomers ||--o{ sales\ncustomers ||--o{ invoices\n\nsales ||--o{ sale_items\nsales ||--o{ payments\nsales ||--o| invoices : generates\n\nsale_items ||--o{ invoice_items\nsale_items ||--o{ cogs_entries\n\ninvoices ||--o{ invoice_items\ninvoices ||--o{ vat_records\n\nstock_adjustment_reasons ||--o{ stock_adjustments\n\nnote right of inventory_layers\n  **FIFO Layer Logic**\n  - Each GRN receipt creates a layer\n  - remaining_quantity decreases on sale\n  - Zero remaining = fully consumed\n  - Cost locked at receipt exchange rate\nend note\n\nnote right of exchange_rates\n  **Multi-Currency Rules**\n  - OFFICIAL: RBZ / ZIMRA rate\n  - BLENDED: weighted average market rate\n  - CUSTOM: user override for specific txns\n  - effective_date allows historical pricing\nend note\n\nnote right of invoices\n  **ZIMRA Fiscalisation**\n  - fiscal_device_id links to ZIMRA-approved device\n  - fiscal_signature is cryptographically signed\n  - zimra_invoice_number is authority-assigned\n  - Credit notes must reference original invoice\nend note\n\nnote bottom of products\n  **Recommended MySQL Indexes**\n  - products(sku), products(barcode), products(category_id)\n  - product_prices(product_id, currency_code, is_active, effective_from)\n  - inventory(product_id, warehouse_id)\n  - inventory_layers(product_id, warehouse_id, remaining_quantity)\n  - inventory_transactions(product_id, warehouse_id, transaction_date)\n  - inventory_consumptions(transaction_id, layer_id)\n  - sales(sale_number, customer_id, sale_date)\n  - sale_items(sale_id, product_id)\n  - invoices(invoice_number, zimra_invoice_number, sale_id)\n  - vat_records(tax_period, vat_category_id, submitted_to_zimra_at)\n  - exchange_rates(from_currency, to_currency, effective_date, rate_type)\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="T4qzdDaVG1-OahGcZJQP-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
